{
  "name": "@anmalass/baileys",
  "type": "module",
  "version": "1.1.0",
  "description": "Anmalass Baileys is an enhanced WhatsApp Web API library based on the Baileys ecosystem, featuring advanced messaging, Native Flow, interactive messages, newsletter support, and extended protocol utilities.",
  "keywords": [
    "baileys",
    "whatsapp",
    "bot",
    "whatsapp-web",
    "automation",
    "anmalass",
    "anmalass-code",
    "type6",
    "native-flow",
    "rich-response",
    "newsletter",
    "lid",
    "anmalass",
    "anmalass-fork"
  ],
  "license": "MIT",
  "author": "Anmalas",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "WAProto/**/*.js",
    "WAProto/**/*.js.map",
    "WAProto/**/*.d.ts",
    "WAProto/**/*.d.ts.map",
    "WAProto/**/*.proto",
    "engine-requirements.js",
    "scripts/validate-dist.mjs",
    "WAProto/GenerateStatics.sh"
  ],
  "scripts": {
    "build:all": "npm run build",
    "build:docs": "typedoc",
    "changelog:last": "conventional-changelog -p angular -r 2",
    "changelog:preview": "conventional-changelog -p angular -u",
    "changelog:update": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "example": "tsx ./Example/example.ts",
    "gen:protobuf": "sh WAProto/GenerateStatics.sh",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\"",
    "formattt": "prettier --write .",
    "formatt": "prettier --write *",
    "lint": "tsc && eslint src --ext .js,.ts",
    "lint:fix": "npm run format && npm run lint -- --fix",
    "preinstall": "node ./engine-requirements.js",
    "release": "release-it",
    "test": "node --experimental-vm-modules ./node_modules/.bin/jest --testMatch '**/*.test.ts'",
    "test:e2e": "node --experimental-vm-modules ./node_modules/.bin/jest --testMatch '**/*.test-e2e.ts'",
    "update:version": "tsx ./scripts/update-version.ts",
    "validate:dist": "node ./scripts/validate-dist.mjs",
    "build": "npm run validate:dist"
  },
  "dependencies": {
    "@cacheable/node-cache": "^1.4.0",
    "@hapi/boom": "^9.1.3",
    "async-mutex": "^0.5.0",
    "fflate": "^0.8.2",
    "libsignal": "https://registry.npmjs.org/@queenanya/libsignal/-/libsignal-5.0.5.tgz",
    "long": "^5.3.2",
    "lru-cache": "^11.1.0",
    "music-metadata": "11.12.1",
    "p-queue": "^9.0.0",
    "pino": "^9.6",
    "protobufjs": "^7.2.4",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-rust-bridge": "0.5.3",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.31.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.9.0",
    "@types/qrcode-terminal": "0.12.2",
    "@types/ws": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "@whiskeysockets/eslint-config": "^1.0.0",
    "conventional-changelog": "^7.1.1",
    "conventional-changelog-angular": "^8.0.0",
    "esbuild-register": "^3.6.0",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.4.0",
    "jest": "^30.0.5",
    "jimp": "^1.6.0",
    "jiti": "^2.4.2",
    "json": "^11.0.0",
    "link-preview-js": "^3.0.0",
    "lru-cache": "^11.1.0",
    "open": "^8.4.2",
    "pino-pretty": "^13.1.1",
    "prettier": "^3.5.3",
    "protobufjs-cli": "^1.1.3",
    "release-it": "^15.10.3",
    "ts-jest": "^29.4.0",
    "tsc-esm-fix": "^3.1.2",
    "tsx": "^4.20.3",
    "typedoc": "^0.27.9",
    "typedoc-plugin-markdown": "4.4.2",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "audio-decode": "^2.1.3",
    "jimp": "^1.6.0",
    "link-preview-js": "^3.0.0",
    "sharp": "*"
  },
  "peerDependenciesMeta": {
    "audio-decode": {
      "optional": true
    },
    "jimp": {
      "optional": true
    },
    "link-preview-js": {
      "optional": true
    }
  },
  "venexvoraFork": {
    "brand": "Anmalass BAILEYS",
    "pairingCode": "ANMALYAA",
    "release": "preview",
    "baseVersion": "1.4.5",
    "featureLevel": 6,
    "features": [
      "Anmalas pairing",
      "Type 6 Buttons",
      "Type 6 Single Select",
      "NativeFlow",
      "Quick Reply V2",
      "URL Button V2",
      "Copy Button V2",
      "Call Button V2",
      "Single Select V2",
      "Carousel Proto",
      "Rich Response Proto",
      "LID Mapping",
      "Newsletter",
      "Group Events",
      "Socket sendType6Buttons",
      "Socket sendType6List",
      "Socket sendVenexvoraButtons",
      "LID Participant Resolver",
      "normalizeUserJid",
      "Message Unwrapper",
      "ViewOnce Unwrapper",
      "Quoted Message Extractor",
      "Media Type Detector",
      "Text Extractor",
      "Message Revoke Parser",
      "Edited Message Parser",
      "Final Socket Interactive Helpers",
      "Venexvora Message Type Alias",
      "Type 6 Full Width Popup Button",
      "Socket sendType6Popup",
      "NativeFlow Single Select Popup",
      "Raw Proto Relay",
      "Reliable Type 6 Relay",
      "Type 6 Popup",
      "NativeFlow Single Select",
      "Carousel V2",
      "Rich HTML UnifiedResponse",
      "Socket TypeScript Helpers",
      "Message Parser Utilities",
      "VenexvoraButtonV2",
      "ButtonV2 Compatible API",
      "Type 6 Raw Button Builder",
      "Single Select Raw Payload",
      "No baileys-mbuilder dependency"
    ],
    "status": "public-preview-candidate-not-security-audited-or-live-tested"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anmalass/Anmalass-Baileys.git"
  },
  "homepage": "https://github.com/Anmalass/Anmalass-Baileys#readme",
  "bugs": {
    "url": "https://github.com/Anmalass/Anmalass-Baileys/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
